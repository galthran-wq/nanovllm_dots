# Build context lives at the repo root (build with `-f deployment/Dockerfile .`).
# Keep this small: the engine code (nanovllm_dots, incl. the native model), the HTTP
# layer (deployment) and the tn stubs (stubs/) are needed; everything heavy --
# including the reference (now native, dev/test-only) -- is excluded.

# 7.4G local virtualenv -- the image builds its own.
.venv/

# 18G of model weights -- mounted at runtime (-v ...:/models), never baked.
/models/

# golden reference audio/latents (dev only).
golden/
golden_mf/

# vendored upstream reference -- no longer installed in the image (the model is
# native now); it's a dev/test-only dependency.
reference/

# vcs + python caches
.git/
.gitignore
**/__pycache__/
*.pyc
*.egg-info/
*.log

# claude / planning scratch
.claude/
